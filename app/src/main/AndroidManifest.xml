<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.GoreeCloudClips"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Non-exported activities in distinct processes isolate WebView cookies and storage. -->
        <activity android:name=".ProfileActivity1" android:process=":clips_profile_1"
            android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ProfileActivity2" android:process=":clips_profile_2"
            android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ProfileActivity3" android:process=":clips_profile_3"
            android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
        <provider android:name=".ProfileRegistryProvider"
            android:authorities="${applicationId}.profiles"
            android:process=":clips_registry"
            android:exported="false" />
    </application>
</manifest>
